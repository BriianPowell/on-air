<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.brianpowell.on-air-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/on-air-agent</string>
		<string>-config</string>
		<string>/Users/USERNAME/.config/on-air/config.yaml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/on-air-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/on-air-agent.err</string>
</dict>
</plist>
